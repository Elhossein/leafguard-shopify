<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a1628">
  <title>
    {% if page_title %}{{ page_title }} – {% endif %}{{ shop.name }}
  </title>
  <meta name="description" content="{{ page_description | escape }}">

  {{ content_for_header }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script>
    window.Shopify = window.Shopify || {};
    window.cartUrl = "{{ routes.cart_url }}";
  </script>
</head>

<body class="airguard-body">

  {% section 'header' %}

  <!-- Sticky ATC Bar -->
  <div id="sticky-atc" class="sticky-atc hidden">
    <div class="sticky-atc__inner container">
      <div class="sticky-atc__product">
        <span class="sticky-atc__name">AirGuard Tape™</span>
        <span class="sticky-atc__price">
          <span class="price-sale">$14.99</span>
          <span class="price-compare">$29.99</span>
        </span>
      </div>
      <button class="btn btn--primary sticky-atc__btn" onclick="document.getElementById('main-add-to-cart').click()">
        GET YOURS NOW — 50% OFF ❄️
      </button>
    </div>
  </div>

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {{ 'theme.js' | asset_url | script_tag }}

  <!-- Cart Drawer -->
  <div id="cart-drawer-overlay" class="cart-overlay hidden"></div>
  <div id="cart-drawer" class="cart-drawer hidden">
    <div class="cart-drawer__header">
      <h3>Your Cart</h3>
      <button class="cart-drawer__close" id="cart-close-btn">✕</button>
    </div>
    <div class="cart-drawer__body" id="cart-drawer-body">
      <p class="cart-empty-msg">Your cart is empty.</p>
    </div>
    <div class="cart-drawer__footer">
      <a href="{{ routes.cart_url }}" class="btn btn--primary btn--full">CHECKOUT SECURELY 🔒</a>
    </div>
  </div>

</body>
</html>
