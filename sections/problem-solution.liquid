<section class="problem-section section">
  <div class="container">
    <div class="problem-section__inner">

      <!-- Visual -->
      <div class="problem-section__visual" data-animate>
        <img
          src="https://www.energytrust.org/wp-content/uploads/2024/05/0723_ETO_RES_PressurizedTest_3875931_02_Test.png"
          alt="Cold drafty window in winter"
          loading="lazy"
          width="700"
          height="525"
        >
        <div class="problem-overlay">
          <span class="problem-overlay__text">😰 Is THIS happening in your home?</span>
        </div>
      </div>

      <!-- Copy -->
      <div data-animate>
        <span class="section__eyebrow">The Problem</span>
        <h2 class="section__title" style="color:var(--navy)">
          Why Is Your Home<br>Still Cold? 🥶
        </h2>
        <p style="color:var(--gray-600);line-height:1.7;margin-bottom:28px;font-size:1rem">
          Even with your heat on full blast, cold air sneaks in through tiny gaps in
          your windows and doors — making your home uncomfortable and your energy
          bills <strong>skyrocket</strong>. Most people don't even realize
          <em>this</em> is the problem.
        </p>

        <ul class="problem-list">
          <li class="problem-item">
            <span class="problem-item__icon">🌬️</span>
            <div>
              <div class="problem-item__title">Invisible Air Leaks</div>
              <div class="problem-item__desc">Tiny gaps around window frames let in a constant stream of freezing air, even when windows are "closed."</div>
            </div>
          </li>
          <li class="problem-item">
            <span class="problem-item__icon">💸</span>
            <div>
              <div class="problem-item__title">Skyrocketing Heating Bills</div>
              <div class="problem-item__desc">The US Dept. of Energy estimates drafts can waste 5–30% of your home's energy use every single month.</div>
            </div>
          </li>
          <li class="problem-item">
            <span class="problem-item__icon">🤧</span>
            <div>
              <div class="problem-item__title">Discomfort &amp; Cold Spots</div>
              <div class="problem-item__desc">Cold drafts make certain rooms unbearable, forcing you to turn the heat up even higher — spending even more.</div>
            </div>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

<!-- Solution Section -->
<section class="solution-section" id="benefits">
  <div class="container">
    <div class="solution-section__inner">

      <!-- Copy -->
      <div data-animate>
        <span class="section__eyebrow">The Solution</span>
        <h2 class="section__title">
          Seal It Instantly<br>with AirGuard™ ❄️→🔥
        </h2>
        <p style="color:rgba(255,255,255,0.65);line-height:1.7;margin-bottom:32px;font-size:1rem">
          AirGuard™ creates an airtight barrier that blocks cold air, dust, and moisture —
          keeping your home warm and your bills low all winter long.
        </p>

        <div class="solution-features">
          <div class="solution-feature">
            <div class="solution-feature__icon-wrap">❄️</div>
            <div>
              <div class="solution-feature__title">Military-Grade Weather Seal</div>
              <div class="solution-feature__desc">Our UV-resistant adhesive is engineered to hold through extreme cold, heat, rain, and humidity.</div>
            </div>
          </div>
          <div class="solution-feature">
            <div class="solution-feature__icon-wrap">⚡</div>
            <div>
              <div class="solution-feature__title">Instant Application</div>
              <div class="solution-feature__desc">Peel, stick, and seal in seconds. No tools, no mess, no contractor needed.</div>
            </div>
          </div>
          <div class="solution-feature">
            <div class="solution-feature__icon-wrap">💰</div>
            <div>
              <div class="solution-feature__title">Immediate Bill Savings</div>
              <div class="solution-feature__desc">Customers report an average 30% reduction in heating costs within the first month.</div>
            </div>
          </div>
          <div class="solution-feature">
            <div class="solution-feature__icon-wrap">🏠</div>
            <div>
              <div class="solution-feature__title">Universal Fit</div>
              <div class="solution-feature__desc">Works on all window types, doors, vents, pipes, and any gap or crack in your home.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Image -->
      <div class="solution-section__image" data-animate>
        <img
          src="https://i5.walmartimages.com/seo/Duck-Max-Strength-Extreme-Weather-1-88-in-x-20-yd-Clear-Tape_e5b60dc3-d78f-484f-86be-1a4f6bc5daa6.ffe0a6cd3ae4ca6e27b4b59c0af073e9.jpeg"
          alt="AirGuard tape sealing window gap"
          loading="lazy"
          width="600"
          height="450"
        >
      </div>

    </div>
  </div>
</section>

