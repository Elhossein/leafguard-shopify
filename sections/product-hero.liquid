{%- assign section_product = all_products[section.settings.featured_product] -%}
{%- if section_product == blank -%}{%- assign section_product = product -%}{%- endif -%}
<section class="product-hero" id="product-hero">
  <div class="container">
    <div class="product-hero__inner">

      <!-- LEFT: Images -->
      <div class="product-hero__images">

        <!-- Main Image -->
        <div class="product-hero__main-img">
          {% if section_product.featured_image %}
            <img
              src="{{ section_product.featured_image | image_url: width: 800 }}"
              alt="{{ section_product.featured_image.alt | escape | default: section_product.title }}"
              width="800"
              height="800"
              loading="eager"
            >
          {% elsif section.settings.image_main %}
            <img
              src="{{ section.settings.image_main | image_url: width: 800 }}"
              alt="AirGuard Tape – Weather Seal"
              width="800"
              height="800"
              loading="eager"
            >
          {% else %}
            <div style="display:flex;align-items:center;justify-content:center;height:100%;min-height:400px;background:rgba(255,255,255,0.05);border-radius:16px;flex-direction:column;gap:12px">
              <span style="font-size:4rem">🛡️</span>
              <span style="color:rgba(255,255,255,0.4);font-size:0.875rem;text-align:center;padding:0 16px">Add images to your product<br>or upload below in the customizer</span>
            </div>
          {% endif %}
        </div>

        <!-- Thumbnails -->
        <div class="product-hero__thumbnails">
          {% if section_product.images.size > 0 %}
            {% for image in section_product.images limit: 4 %}
              <div class="thumb-img {% if forloop.first %}active{% endif %}">
                <img
                  src="{{ image | image_url: width: 200 }}"
                  alt="{{ image.alt | escape | default: section_product.title }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              </div>
            {% endfor %}
          {% else %}
            {% assign thumb_images = section.settings.image_thumb_1 | append: ',' | append: section.settings.image_thumb_2 | append: ',' | append: section.settings.image_thumb_3 | append: ',' | append: section.settings.image_thumb_4 %}
            {% assign thumb_slots = 'image_thumb_1,image_thumb_2,image_thumb_3,image_thumb_4' | split: ',' %}
            {% for slot in thumb_slots %}
              {% assign thumb_img = section.settings[slot] %}
              <div class="thumb-img {% if forloop.first %}active{% endif %}">
                {% if thumb_img %}
                  <img
                    src="{{ thumb_img | image_url: width: 200 }}"
                    alt="AirGuard Tape"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% elsif section.settings.image_main %}
                  <img
                    src="{{ section.settings.image_main | image_url: width: 200 }}"
                    alt="AirGuard Tape"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <div style="width:100%;height:100%;background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;font-size:1.4rem;border-radius:8px">🛡️</div>
                {% endif %}
              </div>
            {% endfor %}
          {% endif %}
        </div>

      </div>

      <!-- RIGHT: Info -->
      <div class="product-hero__info">

        <div class="product-hero__badge-row">
          <span class="product-badge">❄️ WINTER SALE</span>
          <span class="product-badge" style="color:#22c55e;border-color:rgba(34,197,94,0.4);background:rgba(34,197,94,0.1);">✅ IN STOCK</span>
        </div>

        <div class="stars-row" style="margin-bottom:12px">
          <span class="stars">★★★★★</span>
          <span class="review-count" style="color:rgba(255,255,255,0.55)">4.8 · 2,347 Reviews</span>
        </div>

        <h1 class="product-hero__title">
          Stop Cold Air Leaks<br>
          <span>in Seconds ❄️</span>
        </h1>

        <p class="product-hero__tagline">
          {{ section.settings.tagline | default: 'Seal your windows instantly and keep your home warm — without expensive repairs.' }}
        </p>

        <ul class="product-hero__bullets">
          <li class="product-hero__bullet">Blocks cold drafts &amp; air leaks instantly</li>
          <li class="product-hero__bullet">Saves up to 30% on heating bills</li>
          <li class="product-hero__bullet">Easy peel &amp; stick — no tools needed</li>
          <li class="product-hero__bullet">Works on any window, door, or gap</li>
          <li class="product-hero__bullet">UV resistant &amp; fully weather-proof</li>
        </ul>

        <!-- Pack Options -->
        <div class="pack-options">
          <div class="pack-options__label">Choose Your Pack:</div>
          <div class="pack-options__grid">
            {% if section_product.variants.size > 1 %}
              {% for variant in section_product.variants %}
                <button
                  class="pack-option {% if forloop.first %}active{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  data-price="{{ variant.price | money_without_currency }}"
                  data-compare-price="{{ variant.compare_at_price | money_without_currency }}"
                >
                  {{ variant.title }}
                  {% if variant.compare_at_price > variant.price %}
                    <span class="pack-option__save">Save {{ variant.compare_at_price | minus: variant.price | money }}</span>
                  {% endif %}
                </button>
              {% endfor %}
            {% else %}
              <button class="pack-option active" data-variant-id="{{ section_product.first_available_variant.id }}" data-price="34.99" data-compare-price="69.99">
                1 Roll — Best Seller
                <span class="pack-option__save">Save $35.00</span>
              </button>
              <button class="pack-option" data-variant-id="{{ section_product.first_available_variant.id }}" data-price="59.99" data-compare-price="119.99">
                2 Rolls — Most Value
                <span class="pack-option__save">Save $60.00</span>
              </button>
              <button class="pack-option" data-variant-id="{{ section_product.first_available_variant.id }}" data-price="84.99" data-compare-price="169.99">
                3 Rolls — Best Deal 🔥
                <span class="pack-option__save">Save $85.00</span>
              </button>
            {% endif %}
          </div>
        </div>

        <!-- Price -->
        <div class="product-hero__price-row">
          <span class="product-hero__price-sale" id="hero-price-sale">
            {% if section_product.selected_or_first_available_variant.price %}
              {{ section_product.selected_or_first_available_variant.price | money }}
            {% else %}
              $34.99
            {% endif %}
          </span>
          <span class="product-hero__price-compare" id="hero-price-compare">
            {% if section_product.selected_or_first_available_variant.compare_at_price %}
              {{ section_product.selected_or_first_available_variant.compare_at_price | money }}
            {% else %}
              $69.99
            {% endif %}
          </span>
          <span class="product-hero__savings" id="hero-savings-pct">50% OFF</span>
        </div>
        <p id="hero-savings-text" style="font-size:0.8rem;color:rgba(255,255,255,0.45);margin-bottom:16px">You save $35.00 today</p>

        <!-- Quantity + ATC (single form so qty stays in sync) -->
        <form id="product-hero-form" onsubmit="return false;">
          <input type="hidden" name="id" id="variant-id-input" value="{{ section_product.first_available_variant.id }}">

          <div class="product-hero__qty-row">
            <span class="qty-label">Qty:</span>
            <div class="qty-selector">
              <button type="button" class="qty-btn" data-action="minus">−</button>
              <input type="number" class="qty-input" id="qty-input" name="quantity" value="1" min="1" max="99" readonly>
              <button type="button" class="qty-btn" data-action="plus">+</button>
            </div>
          </div>

          <button
            type="button"
            class="btn btn--primary product-hero__atc-btn btn--pulse"
            id="main-add-to-cart"
          >
            🛒 GET YOURS NOW — 50% OFF
          </button>
        </form>

        <p class="product-hero__sub-cta">⚡ Limited time offer — ends when stock runs out</p>

        <!-- Trust Badges -->
        <div class="trust-badges">
          <div class="trust-badge">
            <span class="trust-badge__icon">🔒</span>
            Secure Checkout
          </div>
          <div class="trust-badge">
            <span class="trust-badge__icon">🚚</span>
            Free Shipping
          </div>
          <div class="trust-badge">
            <span class="trust-badge__icon">💰</span>
            30-Day Guarantee
          </div>
          <div class="trust-badge">
            <span class="trust-badge__icon">🇺🇸</span>
            US Warehouse
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
(function () {
  /* ── Element references ── */
  var variantInput  = document.getElementById('variant-id-input');
  var qtyInput      = document.getElementById('qty-input');
  var priceSale     = document.getElementById('hero-price-sale');
  var priceCompare  = document.getElementById('hero-price-compare');
  var savingsPct    = document.getElementById('hero-savings-pct');
  var savingsText   = document.getElementById('hero-savings-text');
  var atcBtn        = document.getElementById('main-add-to-cart');

  /* ── Pack option clicks → update variant ID + prices ── */
  document.querySelectorAll('.pack-option').forEach(function (btn) {
    btn.addEventListener('click', function () {
      /* active state */
      document.querySelectorAll('.pack-option').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');

      /* update hidden variant input */
      var vid = btn.getAttribute('data-variant-id');
      if (variantInput && vid) variantInput.value = vid;

      /* update price display */
      var sale    = parseFloat(btn.getAttribute('data-price'))        || 0;
      var compare = parseFloat(btn.getAttribute('data-compare-price')) || 0;

      if (priceSale)    priceSale.textContent    = '$' + sale.toFixed(2);
      if (priceCompare) priceCompare.textContent = compare > 0 ? '$' + compare.toFixed(2) : '';

      if (compare > 0 && sale > 0) {
        var pct     = Math.round((compare - sale) / compare * 100);
        var saveAmt = (compare - sale).toFixed(2);
        if (savingsPct)  savingsPct.textContent  = pct + '% OFF';
        if (savingsText) savingsText.textContent = 'You save $' + saveAmt + ' today';
      }
    });
  });

  /* ── Qty +/- buttons ── */
  document.querySelectorAll('.qty-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!qtyInput) return;
      var val = parseInt(qtyInput.value, 10) || 1;
      if (btn.getAttribute('data-action') === 'plus')  val = Math.min(val + 1, 99);
      if (btn.getAttribute('data-action') === 'minus') val = Math.max(val - 1, 1);
      qtyInput.value = val;
    });
  });

  /* ── Buy button → AJAX add to cart then go straight to checkout ── */
  if (atcBtn) {
    atcBtn.addEventListener('click', async function () {
      var vid = variantInput ? variantInput.value : '';
      var qty = qtyInput ? parseInt(qtyInput.value, 10) : 1;

      if (!vid || vid === 'null' || vid === '') {
        alert('Please select a pack option first.');
        return;
      }

      var originalHTML = atcBtn.innerHTML;
      atcBtn.disabled  = true;
      atcBtn.textContent = 'Adding to cart…';

      try {
        /* clear cart first so customer only checks out with this item */
        await fetch('/cart/clear.js', { method: 'POST' });

        var res = await fetch('/cart/add.js', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body:    JSON.stringify({ id: parseInt(vid, 10), quantity: qty })
        });

        if (res.ok) {
          window.location.href = '/checkout';
        } else {
          var err = await res.json().catch(function () { return {}; });
          alert(err.description || 'Could not add to cart. Please try again.');
          atcBtn.disabled  = false;
          atcBtn.innerHTML = originalHTML;
        }
      } catch (e) {
        alert('Network error — please check your connection and try again.');
        atcBtn.disabled  = false;
        atcBtn.innerHTML = originalHTML;
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "Product Hero",
  "settings": [
    {
      "type": "product",
      "id": "featured_product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Seal your windows instantly and keep your home warm — without expensive repairs."
    },
    {
      "type": "header",
      "content": "Fallback Images"
    },
    {
      "type": "image_picker",
      "id": "image_main",
      "label": "Main Product Image"
    },
    {
      "type": "image_picker",
      "id": "image_thumb_1",
      "label": "Thumbnail 1"
    },
    {
      "type": "image_picker",
      "id": "image_thumb_2",
      "label": "Thumbnail 2"
    },
    {
      "type": "image_picker",
      "id": "image_thumb_3",
      "label": "Thumbnail 3"
    },
    {
      "type": "image_picker",
      "id": "image_thumb_4",
      "label": "Thumbnail 4"
    }
  ],
  "presets": [{"name": "Product Hero"}]
}
{% endschema %}
