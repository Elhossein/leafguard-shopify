<section class="before-after section">
  <div class="container">
    <div class="text-center">
      <span class="section__eyebrow">See the Difference</span>
      <h2 class="section__title">
        Feel the Difference Instantly 🌡️
      </h2>
      <p style="color:rgba(255,255,255,0.6);font-size:1rem;max-width:520px;margin:0 auto 48px;line-height:1.7">
        Thousands of homeowners have already made the switch. Here's exactly what changes.
      </p>
    </div>

    <div class="before-after__grid">

      <!-- BEFORE -->
      <div class="ba-card ba-card--before" data-animate>
        <div class="ba-card__header">
          ❌ Before AirGuard™
        </div>
        <div class="ba-card__image">
          <img
            src="https://images.unsplash.com/photo-1585771724684-38269d6639fd?w=600&q=80"
            alt="Drafty cold window before sealing"
            loading="lazy"
            width="600"
            height="450"
          >
        </div>
        <ul class="ba-card__list">
          <li class="ba-list-item"><span>❌</span> Cold air leaks through gaps</li>
          <li class="ba-list-item"><span>❌</span> Curtains blowing from drafts</li>
          <li class="ba-list-item"><span>❌</span> High heating &amp; cooling bills</li>
          <li class="ba-list-item"><span>❌</span> Uncomfortable, cold rooms</li>
          <li class="ba-list-item"><span>❌</span> Thermostat cranked but still cold</li>
        </ul>
      </div>

      <!-- VS Badge -->
      <div class="ba-vs">
        <div class="ba-vs__badge">VS</div>
      </div>

      <!-- AFTER -->
      <div class="ba-card ba-card--after" data-animate>
        <div class="ba-card__header">
          ✅ After AirGuard™
        </div>
        <div class="ba-card__image">
          <img
            src="https://images.unsplash.com/photo-1600585152220-90363fe7e115?w=600&q=80"
            alt="Warm cozy room after sealing windows"
            loading="lazy"
            width="600"
            height="450"
          >
        </div>
        <ul class="ba-card__list">
          <li class="ba-list-item"><span>✅</span> Airtight seal — zero drafts</li>
          <li class="ba-list-item"><span>✅</span> Still air, warm &amp; comfortable</li>
          <li class="ba-list-item"><span>✅</span> Up to 30% lower energy bills</li>
          <li class="ba-list-item"><span>✅</span> Every room perfectly heated</li>
          <li class="ba-list-item"><span>✅</span> Thermostat lower, savings higher</li>
        </ul>
      </div>

    </div>

    <!-- Money Angle CTA -->
    <div
      style="margin-top:48px;background:rgba(255,107,26,0.1);border:1.5px solid rgba(255,107,26,0.3);border-radius:16px;padding:32px;text-align:center"
      data-animate
    >
      <p style="font-size:1.35rem;font-weight:900;color:var(--white);margin-bottom:8px">
        💸 This Gap Is Costing You $$$
      </p>
      <p style="color:rgba(255,255,255,0.65);font-size:1rem;margin-bottom:24px;line-height:1.7">
        The average US household loses <strong style="color:var(--orange)">$400+/year</strong> through drafts and air leaks.
        AirGuard™ pays for itself in the <strong style="color:var(--orange)">first week</strong>.
      </p>
      <a href="#product-hero" class="btn btn--primary btn--xl">
        🛒 SEAL IT NOW — 50% OFF TODAY
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Before & After",
  "settings": [],
  "presets": [{"name": "Before & After"}]
}
{% endschema %}
