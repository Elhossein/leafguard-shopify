<div class="stats-bar">
  <div class="container">
    <div class="stats-bar__inner">
      <div class="stat-item" data-animate>
        <div class="stat-item__number"><span>2,347</span>+</div>
        <div class="stat-item__label">Happy Customers</div>
      </div>
      <div class="stat-item" data-animate>
        <div class="stat-item__number"><span>4.8</span>★</div>
        <div class="stat-item__label">Average Rating</div>
      </div>
      <div class="stat-item" data-animate>
        <div class="stat-item__number"><span>30</span>%</div>
        <div class="stat-item__label">Average Bill Savings</div>
      </div>
      <div class="stat-item" data-animate>
        <div class="stat-item__number"><span>60</span>s</div>
        <div class="stat-item__label">Install Time</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Stats Bar",
  "settings": [],
  "presets": [{"name": "Stats Bar"}]
}
{% endschema %}
