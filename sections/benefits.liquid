<section class="benefits-section section">
  <div class="container">
    <div class="text-center">
      <span class="section__eyebrow">Why AirGuard™</span>
      <h2 class="section__title" style="color:var(--navy)">
        Everything You Need.<br>Nothing You Don't.
      </h2>
      <p class="section__subtitle">
        Designed for homeowners who want real results — fast.
      </p>
    </div>

    <div class="benefits-grid">

      <div class="benefit-card" data-animate>
        <span class="benefit-card__icon">❄️</span>
        <div class="benefit-card__title">Blocks Cold Air</div>
        <div class="benefit-card__desc">Creates an airtight barrier against freezing drafts and cold air infiltration.</div>
      </div>

      <div class="benefit-card" data-animate>
        <span class="benefit-card__icon">💰</span>
        <div class="benefit-card__title">Saves Money</div>
        <div class="benefit-card__desc">Lower your heating &amp; cooling bills by up to 30% — starting this month.</div>
      </div>

      <div class="benefit-card" data-animate>
        <span class="benefit-card__icon">⚡</span>
        <div class="benefit-card__title">Installs in Seconds</div>
        <div class="benefit-card__desc">Peel, stick, done. Zero tools required. Anyone can do it in under a minute.</div>
      </div>

      <div class="benefit-card" data-animate>
        <span class="benefit-card__icon">🛡️</span>
        <div class="benefit-card__title">All-Season Proof</div>
        <div class="benefit-card__desc">UV-resistant and weatherproof — holds strong through extreme cold, heat, and rain.</div>
      </div>

      <div class="benefit-card" data-animate>
        <span class="benefit-card__icon">✨</span>
        <div class="benefit-card__title">Crystal Clear</div>
        <div class="benefit-card__desc">Near-invisible when applied — preserves the look of your windows and doors.</div>
      </div>

      <div class="benefit-card" data-animate>
        <span class="benefit-card__icon">🔄</span>
        <div class="benefit-card__title">Clean Removal</div>
        <div class="benefit-card__desc">Removes cleanly without residue or damage — safe for all window types.</div>
      </div>

      <div class="benefit-card" data-animate>
        <span class="benefit-card__icon">🏠</span>
        <div class="benefit-card__title">Universal Fit</div>
        <div class="benefit-card__desc">Works on windows, doors, pipes, vents, and any crack or gap in your home.</div>
      </div>

      <div class="benefit-card" data-animate>
        <span class="benefit-card__icon">💧</span>
        <div class="benefit-card__title">Waterproof</div>
        <div class="benefit-card__desc">100% waterproof adhesive — won't weaken or peel in wet or humid conditions.</div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "settings": [],
  "presets": [{"name": "Benefits"}]
}
{% endschema %}
